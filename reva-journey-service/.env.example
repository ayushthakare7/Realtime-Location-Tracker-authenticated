# Run from the reva-journey-service directory.
# Shared DB lets this service validate Reva Friendship records; journeys/notifications use separate collections.
MONGO_URI=mongodb://127.0.0.1:27017/location_tracker
JWT_SECRET=replace_with_the_same_long_random_secret_as_reva_api
JOURNEY_SERVICE_PORT=3001
JOURNEY_CLIENT_ORIGIN=http://localhost:3000
VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
JOURNEY_OVERDUE_GRACE_MINUTES=5
JOURNEY_WORKER_INTERVAL_MS=30000
