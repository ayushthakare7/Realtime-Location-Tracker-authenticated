<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f6f2">
  <title>Reva: Welcome</title>
  <link rel="stylesheet" href="/css/style.css">\n  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
  <style>
    .auth-page{min-height:100vh;display:grid;place-items:center;padding:28px 16px;background:var(--canvas)}
    .auth-card{width:min(100%,440px);padding:clamp(25px,6vw,42px);border:1px solid var(--line);border-radius:25px;background:rgba(255,254,250,.94);box-shadow:0 24px 80px rgba(42,59,48,.09)}
    .auth-brand{display:flex;justify-content:center;margin-bottom:32px}.auth-kicker{text-align:center;color:#849688;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}
    .auth-card h1{text-align:center;margin:8px 0 9px;font:700 29px/1.2 'Manrope',sans-serif;letter-spacing:-1px}.auth-lede{text-align:center;margin:0 auto 27px;max-width:300px;color:var(--muted);font-size:13px;line-height:1.7}
    .auth-form{display:grid;gap:15px}.auth-form label{display:grid;gap:7px;color:#52635a;font-size:12px;font-weight:600}.auth-form input{padding:13px 14px;border-radius:12px}.auth-form button{margin-top:5px;padding:13px;border:0;border-radius:12px;background:var(--sage-dark);color:white;font-weight:700}.auth-form button:hover{background:#264a3b}.auth-form button:disabled{opacity:.65;cursor:wait}
    .auth-foot{text-align:center;margin:23px 0 0;color:var(--muted);font-size:12px}.auth-foot a{color:var(--sage-dark);font-weight:700;text-decoration:none}.auth-foot a:hover{text-decoration:underline}
    .auth-message{margin:12px 0 0;color:#a44e48;font-size:12px;text-align:center}.auth-note{display:flex;gap:9px;align-items:flex-start;margin-top:24px;padding:12px;border-radius:12px;background:#f4f5ef;color:#7c887e;font-size:11px;line-height:1.6}

    .auth-page { position:relative; z-index:1; min-height:100svh; background:transparent; }
    .auth-map-backdrop { position:fixed; inset:-3%; z-index:0; overflow:hidden; background:#e7ebe3; }
    .auth-map-backdrop .leaflet-container { width:100%; height:100%; background:#e7ebe3; }
    .auth-map-backdrop .leaflet-tile-pane { filter:saturate(.58) contrast(.92) brightness(1.05); opacity:.78; }
    .auth-map-shade { position:fixed; inset:0; z-index:0; pointer-events:none; background:rgba(246,246,242,.48); }
    .auth-card { position:relative; z-index:2; background:rgba(255,254,250,.91); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); }
    .auth-map-pin { width:15px;height:15px;border-radius:50%;background:#527765;border:3px solid #fffefa;box-shadow:0 2px 12px rgba(36,51,47,.32); }
    .auth-map-pin.auth-map-pin-lavender { background:#8b7d9f; }
    .auth-map-pin.auth-map-pin-gold { background:#c19c62; }
    .auth-map-label { padding:5px 9px;border-radius:999px;background:rgba(255,254,250,.94);border:1px solid rgba(82,119,101,.22);color:#315748;font:600 11px/1.2 'DM Sans',sans-serif;box-shadow:0 4px 15px rgba(42,59,48,.10);white-space:nowrap; }
    .auth-map-backdrop .leaflet-control-attribution { font-size:9px; background:rgba(255,254,250,.72); }
    @media (prefers-reduced-motion: reduce) { .auth-map-backdrop { display:none; } .auth-page { background:var(--canvas); } }
\n  </style>
</head>
<body>
  <div class="auth-map-backdrop" id="authMap" aria-hidden="true"></div>\n  <div class="auth-map-shade" aria-hidden="true"></div>\n  <main class="auth-page">
    <section class="auth-card">
      <a class="wordmark auth-brand" href="/login" aria-label="Reva home"><span class="wordmark-mark" aria-hidden="true">✳</span><span style="text-align:left"><strong>Reva</strong><small>your people, in orbit</small></span></a>
      <p class="auth-kicker">A little closer, wherever you are</p>
      <h1>Welcome back.</h1>
      <p class="auth-lede">Your people, your places, your pace. Pick up right where you left off.</p>
      <form id="loginForm" class="auth-form">
        <label for="email">Email address<input type="email" id="email" placeholder="you@example.com" autocomplete="email" required></label>
        <label for="password">Password<input type="password" id="password" placeholder="Enter your password" autocomplete="current-password" required></label>
        <button type="submit">Sign in gently →</button>
      </form>
      <p id="authMessage" class="auth-message" role="status"></p>
      <p class="auth-foot">New to Reva? <a href="/register">Create an account</a></p>
      <div class="auth-note"><span aria-hidden="true">◈</span><span>Your location stays private by default. You decide when to share it and with whom.</span></div>
    </section>
  </main>
<script>
document.getElementById("loginForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const button = e.currentTarget.querySelector("button[type=submit]");
  const message = document.getElementById("authMessage");
  button.disabled = true; button.textContent = "Signing you in…"; message.textContent = "";
  try {
    const response = await fetch("/api/auth/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        email: document.getElementById("email").value,
        password: document.getElementById("password").value
      })
    });
    const data = await response.json();
    if (data.success) {
      localStorage.setItem("token", data.token);
      window.location.href = "/tracker";
    } else {
      message.textContent = data.message || "We couldn't sign you in. Please check your details.";
    }
  } catch (_) {
    message.textContent = "Something went wrong. Please try again in a moment.";
  } finally {
    button.disabled = false; button.textContent = "Sign in gently →";
  }
});
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(() => {
  const host = document.getElementById("authMap");
  if (!host || !window.L || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const map = L.map(host, {
    zoomControl: false, scrollWheelZoom: false, dragging: false, doubleClickZoom: false,
    touchZoom: false, keyboard: false, attributionControl: true, zoomAnimation: true,
    fadeAnimation: true
  }).setView([22.8, 79.0], 4.6);
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 18, minZoom: 4, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
  }).addTo(map);
  const pin = (tone) => L.divIcon({className:"",html:'<span class="auth-map-pin '+tone+'"></span>',iconSize:[15,15],iconAnchor:[7,7]});
  const spots = [
    {p:[28.6139,77.2090],tone:"",label:"Your circle"},
    {p:[19.0760,72.8777],tone:"auth-map-pin-lavender",label:"Meet nearby"},
    {p:[12.9716,77.5946],tone:"auth-map-pin-gold",label:"A familiar place"},
    {p:[22.5726,88.3639],tone:"",label:"Shared moments"},
    {p:[26.9124,75.7873],tone:"auth-map-pin-lavender",label:"New connections"},
    {p:[17.3850,78.4867],tone:"auth-map-pin-gold",label:"Around your world"}
  ];
  spots.forEach((spot,i) => {
    L.marker(spot.p,{icon:pin(spot.tone),interactive:false}).addTo(map);
    if (i===0 || i===2) L.marker([spot.p[0]+.0012,spot.p[1]+.0014],{
      icon:L.divIcon({className:"",html:'<span class="auth-map-label">'+spot.label+'</span>',iconSize:[100,25],iconAnchor:[0,30]}),
      interactive:false
    }).addTo(map);
  });
  // Fast cinematic sweeps across India, then a slow zoom-in/zoom-out at
  // a randomly selected anonymous map point. No live user location is used.
  // Fast camera hops across India, followed by a deliberate slow zoom-in/out.
  const sweepViews = [
    [28.6139,77.2090], [19.0760,72.8777], [12.9716,77.5946],
    [22.5726,88.3639], [26.9124,75.7873], [17.3850,78.4867],
    [21.1458,79.0882], [23.2599,77.4126], [25.5941,85.1376],
    [15.2993,74.1240], [20.2961,85.8245], [26.1445,91.7362]
  ];
  const randomTargets = [
    [31.1048,77.1734], [29.0588,76.0856], [24.5854,73.7125],
    [21.1458,79.0882], [18.5204,72.8777], [16.5062,80.6480],
    [11.0168,76.9558], [15.8497,74.4977], [23.2599,77.4126],
    [25.5941,85.1376], [26.1445,91.7362], [22.7196,75.8577],
    [17.6868,83.2185], [30.7333,76.7794], [19.9975,73.7898],
    [20.2961,85.8245], [10.8505,76.2711], [26.2389,73.0243],
    [27.1767,78.0081], [22.3072,73.1812], [9.9312,76.2673],
    [23.0225,72.5714], [18.1124,83.4012], [24.8799,74.6295]
  ];
  const wait = ms => new Promise(resolve => window.setTimeout(resolve, ms));
  const travel = (center, zoom, duration, easing=0.2) => new Promise(resolve => {
    let finished = false;
    const done = () => {
      if (finished) return;
      finished = true;
      map.off("moveend", done);
      resolve();
    };
    map.once("moveend", done);
    map.flyTo(center, zoom, { animate:true, duration, easeLinearity:easing });
    window.setTimeout(done, duration * 1000 + 1200);
  });
  const cinematicJourney = async () => {
    let sweepIndex = Math.floor(Math.random() * sweepViews.length);
    let previousTarget = -1;
    while (host.isConnected) {
      // Rapidly travel across different regions; shuffle the starting point each cycle.
      const hops = 4 + Math.floor(Math.random() * 3);
      for (let i=0; i<hops; i++) {
        const center = sweepViews[sweepIndex % sweepViews.length];
        sweepIndex = (sweepIndex + 1 + Math.floor(Math.random() * 3)) % sweepViews.length;
        await travel(center, 4.65, 1.15 + Math.random() * 0.45, 0.28);
      }

      // Choose a new anonymous target, then slow down for the close-up and pull-back.
      let targetIndex;
      do {
        targetIndex = Math.floor(Math.random() * randomTargets.length);
      } while (targetIndex === previousTarget);
      previousTarget = targetIndex;
      const target = randomTargets[targetIndex];

      await travel(target, 4.65, 1.2, 0.25);
      await wait(180);
      await travel(target, 7.3, 2.8, 0.12);
      await wait(650);
      await travel(target, 4.65, 1.9, 0.14);
      await wait(180);
    }
  };
  // Start as soon as the map is ready; continue until the page is left.
  requestAnimationFrame(() => { cinematicJourney(); });
    window.addEventListener("resize",()=>map.invalidateSize({pan:false}));
})();
</script>\n</body>
</html>
