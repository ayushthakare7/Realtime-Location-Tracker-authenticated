<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reva: Stay close, feel connected.</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<style>.mobility-entry-button{display:flex;align-items:center;gap:11px;margin-top:13px;padding:12px 13px;border:1px solid #dce6dc;border-radius:13px;background:linear-gradient(120deg,#edf3eb,#f4eef8);color:#294d40;text-decoration:none;box-shadow:0 7px 18px rgba(41,77,64,.08)}.mobility-entry-button>span:first-child{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:#dce8dd;font-size:19px}.mobility-entry-button strong,.mobility-entry-button small{display:block}.mobility-entry-button strong{font:700 13px Manrope,sans-serif}.mobility-entry-button small{margin-top:2px;color:#78847d;font-size:10px}.mobility-entry-arrow{margin-left:auto;font-size:19px}.mobility-entry-button:hover{transform:translateY(-1px);border-color:#b8cfba}.mobility-header-link{display:inline-flex;align-items:center;gap:6px;padding:9px 12px;border-radius:10px;background:#294d40;color:#fff;text-decoration:none;font-weight:700;font-size:12px;white-space:nowrap}.mobility-header-link:hover{background:#1e3c31}</style>
</head>
<body class="app-shell">
<header class="app-header"><a class="wordmark header-choice" href="/tracker" aria-label="Shared by choice"><span class="privacy-note"><span aria-hidden="true">◈</span> Shared by choice</span></a><p class="header-tagline">Stay close, <em>feel connected.</em></p><div class="header-actions"><a class="mobility-header-link" href="/mobility">↗ Plan a Journey</a><span id="gpsInfo" class="gps-pill"><span class="status-dot"></span> GPS idle</span><button id="logout" class="secondary logout-button">Log out</button></div></header>
<div class="page-intro"><div class="intro-center"><p class="intro-copy">Your people, their places, one little world to explore.</p></div></div>
<main class="dashboard-grid">
  <aside>
    <section class="panel sharing-panel">
      <div class="section-heading"><span class="section-icon" aria-hidden="true">⌖</span><div><p class="eyebrow">YOUR PRESENCE</p><h2>Location sharing</h2></div></div>
      <p class="muted">Your location is off by default. Turn it on only when you want accepted friends to see your latest location.</p>
      <button id="start">Start sharing</button> <button id="stop" class="secondary">Stop sharing</button>
      <div id="status">Sharing is off until you opt in.</div>
      <a class="mobility-entry-button" href="/mobility"><span aria-hidden="true">↗</span><span><strong>Plan a Journey</strong><small>Choose a vehicle · set destination · track your trip</small></span><span class="mobility-entry-arrow">→</span></a>
    </section>
  <section class="panel friends-panel">
      <div class="section-heading"><span class="section-icon" aria-hidden="true">♡</span><div><p class="eyebrow">YOUR CIRCLE</p><h2>Friends</h2></div></div>
      <form id="friendForm"><input id="friendUsername" placeholder="Friend's exact username" required><button>Send request</button></form>
      <div id="requests"></div><div id="friends">Loading friends…</div>
    </section>
    <section class="panel shared-journeys-panel">
      <div class="section-heading"><span class="section-icon" aria-hidden="true">↗</span><div><p class="eyebrow">LIVE UPDATES</p><h2>Friends' journeys</h2></div></div>
      <p class="muted">Active journeys your friends have explicitly shared with you appear here.</p>
      <div id="sharedJourneys" aria-live="polite"><p class="muted">Checking for shared journeys…</p></div>
    </section>
    <section class="panel privacy-panel">
      <div class="section-heading"><span class="section-icon" aria-hidden="true">◈</span><div><p class="eyebrow">YOUR CHOICES</p><h2>Privacy controls</h2></div></div>
      <div class="switch-row"><span>Store location history</span><input id="historyToggle" type="checkbox" checked></div>
      <p class="muted">When disabled, new GPS history points and semantic location events are not stored. Live sharing can still work.</p>
      <button id="deleteHistory" class="secondary">Delete my location history</button>
    </section>
  </aside>
  <section class="map-stage" aria-label="Friend radar map">
  <div class="map-heading"><div><p class="eyebrow">FRIEND RADAR</p><h2>Your crew, in orbit</h2></div><span class="map-caption"><span class="status-dot"></span> Only shared locations appear here</span></div>
  <div class="map-frame"><div id="map"></div><div class="map-overlay"><span class="radar-pulse"></span><span><strong>THE RADAR</strong><small>Finding your people, one pin at a time</small></span></div><div class="map-hint" id="mapHint">Turn on sharing to start your map sequence</div></div>
</section>
  <section class="map-stack">
    <section class="panel reva-card">
      <div class="reva-brand"><div class="reva-avatar" aria-hidden="true">✦</div><div><h2 class="reva-title">Ask Reva</h2><div class="reva-subtitle">Your location sidekick for places, distances and shared adventures.</div></div></div>
      <p class="muted">Ask about shared visits, time spent at a place, recent movements, current locations, distances, or your location history. Reva retrieves only authorized semantic events before generating an answer.</p>
      <div class="reva-prompts" aria-label="Try a question">
        <button type="button" id="currentLocationPrompt" data-question="">⌖ Current location</button>
        <button type="button" data-question="What places did my friends visit recently?">↗ Recent places</button>
        <button type="button" data-question="How long did my friends stay at each place?">◷ Time spent</button>
        <button type="button" data-question="Summarize my movement today">✳ My day</button>
      </div>
      <form id="askForm"><textarea id="question" rows="3" maxlength="500" placeholder="Ask Reva about a place, visit, movement, or distance…" required></textarea><label style="display:block;font-size:13px"><input id="aiConsent" type="checkbox" required style="width:auto"> I agree to send the relevant shared location records to Reva's external AI service to answer this question. Location details can be sensitive.</label><button type="submit">Solve the mystery ↗</button></form>
      <p id="answer" aria-live="polite"></p>
    </section>
  </section>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/script.js"></script>
<script src="/js/reva-push-notifications.js"></script>
</body>
</html>
