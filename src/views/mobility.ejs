<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f3f0e9">
  <title>My Journey · Reva</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
  <link rel="stylesheet" href="/css/mobility.css">
</head>
<body class="app-shell mobility-page">
<header class="app-header">
  <a class="wordmark header-choice" href="/tracker" aria-label="Shared by choice"><span class="privacy-note"><span aria-hidden="true">◈</span> Shared by choice</span></a>
  <p class="header-tagline">Every journey, <em>closer to there.</em></p>
  <div class="header-actions"><span id="mobilityConnection" class="gps-pill"><span class="status-dot"></span> Connecting…</span><a class="mobility-header-link" href="/tracker">← Back to Reva</a></div>
</header>
<main class="mobility-shell">
  <section class="mobility-layout">
    <section class="panel journey-status-panel">
      <div class="section-heading"><span class="section-icon">◷</span><div><p class="eyebrow">LIVE JOURNEY</p><h2 id="journeyHeading">Ready when you are</h2></div></div>
      <div id="journeyStatus" class="journey-status" role="status">Choose a destination to get started.</div>
      <div class="eta-grid">
        <div><small>EXPECTED ARRIVAL</small><strong id="etaValue">—</strong></div>
        <div><small>ROAD DISTANCE</small><strong id="distanceValue">—</strong></div>
        <div><small>TRAVEL TIME</small><strong id="durationValue">—</strong></div>
      </div>
      <p id="lastLocationInfo" class="last-location-info">Waiting for journey location.</p>
      <div class="journey-actions"><button id="arrivedButton" type="button" class="secondary" disabled>I've arrived</button><button id="endJourney" type="button" class="secondary" disabled>End journey</button></div>
    </section>

    <form id="journeyForm" class="journey-planner-form">
      <section class="panel journey-form-panel destination-panel">
        <div class="section-heading"><span class="section-icon">⌖</span><div><p class="eyebrow">PLAN A JOURNEY</p><h2>Where to?</h2></div></div>
        <p class="muted">Search for a destination or select a point directly on the map.</p>
        <label for="destinationQuery">Destination</label>
        <div class="destination-search"><input id="destinationQuery" maxlength="160" placeholder="Search place or address" autocomplete="off"><button id="searchDestination" type="button" aria-label="Search destination">Search</button></div>
        <button id="pickDestinationOnMap" type="button" class="map-pick-button">⌖ Pick on Map</button>
        <div id="mapPickActions" class="map-pick-actions" hidden><p>Tap anywhere on the map to place your destination pin. You can zoom and pan first.</p><div><button id="confirmMapDestination" type="button" disabled>Use This Destination</button><button id="cancelMapPick" type="button" class="secondary">Cancel</button></div></div>
        <div id="destinationResults" class="destination-results" role="listbox"></div>
        <p id="selectedDestination" class="selected-destination">Search for a place or pick a point directly on the map.</p>
        <div class="destination-tip"><span aria-hidden="true">✦</span><p><strong>Choose your exact destination</strong><small>Search for a place, or pick a pin on the map. Your destination stays fixed while your live position updates.</small></p></div>
        <aside class="start-journey-panel">
            <p class="eyebrow">READY TO GO?</p>
            <h3>Start your journey</h3>
            <label for="recipientMode">Share updates with</label>
            <select id="recipientMode"><option value="ALL_FRIENDS">All eligible friends</option><option value="SELECTED_FRIENDS">Selected friends</option><option value="ONE_FRIEND">One friend</option></select>
            <div id="friendChoices" class="friend-choices" hidden></div>
            <button id="startJourney" class="mobility-primary" type="submit">Start journey ↗</button>
            <p class="form-note">Location sharing must be enabled on the main Reva page. Bus and train ETAs are road estimates, not live transit schedules.</p>
          </aside>
      </section>

      <section class="journey-map-section">
        <div class="map-heading"><div><p class="eyebrow">ROAD ROUTE</p><h2>Follow your journey</h2></div><span id="routeSource" class="map-caption">Waiting for route</span></div>
        <div class="journey-map-frame"><div id="journeyMap" aria-label="Live journey road map"></div><div class="journey-map-overlay"><span class="journey-map-pulse"></span><span><strong>MY JOURNEY</strong><small id="mapSubtitle">Your city, your route</small></span></div><button id="recenterMap" type="button" class="recenter-button">◎ Recenter</button></div>
        <div class="route-legend"><span><i class="legend-dot legend-you"></i> Your live position</span><span><i class="legend-line"></i> Road route</span><span><i class="legend-dot legend-destination"></i> Destination</span></div>
        <div class="panel mobility-explainer"><strong>How ETA works</strong><p>ETA is based on the road route, not straight-line distance. Reva refreshes the estimate as your location changes.</p></div>
      </section>

      <section class="panel journey-form-panel travel-options-panel">
        <div class="travel-options-heading"><div class="section-heading"><span class="section-icon">↗</span><div><p class="eyebrow">YOUR RIDE</p><h2>Choose your vehicle</h2></div></div></div>
        <div class="travel-options-content">
          <div id="transportModeCards" class="transport-mode-grid" role="group" aria-label="Choose travel mode">
            <button type="button" class="transport-mode-card is-selected" data-mode="driving-car" aria-pressed="true"><span class="mode-art mode-art-car" aria-hidden="true"></span><strong>Car</strong><small>Road vehicle</small></button>
            <button type="button" class="transport-mode-card" data-mode="cycling-regular" aria-pressed="false"><span class="mode-art mode-art-bicycle" aria-hidden="true"></span><strong>Bicycle</strong><small>Cycle route</small></button>
            <button type="button" class="transport-mode-card" data-mode="motorbike" aria-pressed="false"><span class="mode-art mode-art-motorbike" aria-hidden="true"></span><strong>Bike</strong><small>Motorbike</small></button>
            <button type="button" class="transport-mode-card" data-mode="foot-walking" aria-pressed="false"><span class="mode-art mode-art-walking" aria-hidden="true"></span><strong>Walking</strong><small>On foot</small></button>
            <button type="button" class="transport-mode-card" data-mode="bus" aria-pressed="false"><span class="mode-art mode-art-bus" aria-hidden="true"></span><strong>Bus</strong><small>Road estimate</small></button>
            <button type="button" class="transport-mode-card" data-mode="train" aria-pressed="false"><span class="mode-art mode-art-train" aria-hidden="true"></span><strong>Train</strong><small>Route estimate</small></button>
          </div>
          <div class="transport-mode-select-wrap"><select id="transportMode" class="transport-mode-source" aria-label="Selected travel mode" tabindex="-1">
            <option value="driving-car" selected>Car / road vehicle</option><option value="cycling-regular">Bicycle</option><option value="motorbike">Bike / motorbike</option><option value="foot-walking">Walking</option><option value="bus">Bus (road estimate)</option><option value="train">Train (route estimate)</option>
          </select></div>
          
        </div>
      </section>
    </form>
  </section>
  <p id="mobilityMessage" class="mobility-message" aria-live="polite"></p>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>window.REVA_SHARED_TRIP_ID = <%- JSON.stringify(sharedTripId || null) %>;</script>
<script src="/js/mobility.js"></script>
<script src="/js/reva-push-notifications.js"></script>
</body>
</html>
