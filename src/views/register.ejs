<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f6f2">
  <title>Reva: Welcome</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
  <style>
    .auth-page{min-height:100vh;display:grid;place-items:center;padding:28px 16px;background:var(--canvas)}
    .auth-card{width:min(100%,460px);padding:clamp(25px,6vw,42px);border:1px solid var(--line);border-radius:25px;background:rgba(255,254,250,.94);box-shadow:0 24px 80px rgba(42,59,48,.09)}
    .auth-brand{display:flex;justify-content:center;margin-bottom:32px}.auth-kicker{text-align:center;color:#849688;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}
    .auth-card h1{text-align:center;margin:8px 0 9px;font:700 29px/1.2 'Manrope',sans-serif;letter-spacing:-1px}.auth-lede{text-align:center;margin:0 auto 27px;max-width:310px;color:var(--muted);font-size:13px;line-height:1.7}
    .auth-form{display:grid;gap:15px}.auth-form label{display:grid;gap:7px;color:#52635a;font-size:12px;font-weight:600}.auth-form input{padding:13px 14px;border-radius:12px}.auth-form button{margin-top:5px;padding:13px;border:0;border-radius:12px;background:var(--sage-dark);color:white;font-weight:700}.auth-form button:hover{background:#264a3b}.auth-form button:disabled{opacity:.65;cursor:wait}
    .auth-foot{text-align:center;margin:23px 0 0;color:var(--muted);font-size:12px}.auth-foot a{color:var(--sage-dark);font-weight:700;text-decoration:none}.auth-foot a:hover{text-decoration:underline}
    .auth-message{margin:12px 0 0;color:#a44e48;font-size:12px;text-align:center}.auth-note{display:flex;gap:9px;align-items:flex-start;margin-top:24px;padding:12px;border-radius:12px;background:#f4f5ef;color:#7c887e;font-size:11px;line-height:1.6}

    .auth-page { min-height:100svh; background:var(--canvas); }
/* Keep the map crisp and remove the two decorative circular patches. */
    .auth-card { backdrop-filter:blur(5px); -webkit-backdrop-filter:blur(5px); }

    }
\n  </style>
</head>
<body>
<main class="auth-page">
    <div id="authMap" class="auth-map-background" aria-hidden="true"></div>
    <section class="auth-card">
      <a class="wordmark auth-brand" href="/register" aria-label="Reva home"><span class="wordmark-mark" aria-hidden="true">✳</span><span style="text-align:left"><strong>Reva</strong><small>your people, in orbit</small></span></a>
      <p class="auth-kicker">Make room for your people</p>
      <h1>Find your circle.</h1>
      <p class="auth-lede">A calmer space to stay connected. You choose what you share, and when.</p>
      <form id="registerForm" class="auth-form">
        <label for="username">Your username<input type="text" id="username" placeholder="How friends will find you" autocomplete="username" required></label>
        <label for="email">Email address<input type="email" id="email" placeholder="you@example.com" autocomplete="email" required></label>
        <label for="password">Create a password<input type="password" id="password" placeholder="Choose a secure password" autocomplete="new-password" required></label>
        <button type="submit">Create my space →</button>
      </form>
      <p id="authMessage" class="auth-message" role="status"></p>
      <p class="auth-foot">Already have an account? <a href="/login">Sign in</a></p>
      <div class="auth-note"><span aria-hidden="true">◈</span><span>Sharing starts off. You remain in control of your location and your history.</span></div>
    </section>
  </main>
<script>
document.getElementById("registerForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const button = e.currentTarget.querySelector("button[type=submit]");
  const message = document.getElementById("authMessage");
  button.disabled = true; button.textContent = "Creating your account…"; message.textContent = "";
  try {
    const response = await fetch("/api/auth/register", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        username: document.getElementById("username").value,
        email: document.getElementById("email").value,
        password: document.getElementById("password").value
      })
    });
    const data = await response.json();
    message.textContent = data.message || (data.success ? "Account created. Taking you to sign in…" : "We couldn't create your account.");
    if (data.success) setTimeout(() => { window.location.href = "/login"; }, 700);
  } catch (_) {
    message.textContent = "Something went wrong. Please try again in a moment.";
  } finally {
    button.disabled = false; button.textContent = "Create my space →";
  }
});
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
  (() => {
    const mapElement = document.getElementById("authMap");
    if (!mapElement || !window.L) return;
    const authMap = L.map(mapElement, {
      zoomControl: false,
      attributionControl: false,
      dragging: false,
      touchZoom: false,
      scrollWheelZoom: false,
      doubleClickZoom: false,
      boxZoom: false,
      keyboard: false,
      tap: false,
      zoomAnimation: false,
      fadeAnimation: false,
      markerZoomAnimation: false,
      inertia: false
    }).setView([20.5937, 78.9629], 5);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "© OpenStreetMap contributors",
      subdomains: "abc",
      maxZoom: 19
    }).addTo(authMap);
    setTimeout(() => authMap.invalidateSize(false), 100);

    // Gentle, alternating map drift adds life without distracting from the form.
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (!reducedMotion.matches) {
      let driftForward = true;
      let driftTimer;
      const drift = () => {
        if (document.hidden || reducedMotion.matches) {
          driftTimer = setTimeout(drift, 3000);
          return;
        }
        authMap.panBy(driftForward ? [26, 12] : [-26, -12], {
          animate: true,
          duration: 7
        });
        driftForward = !driftForward;
        driftTimer = setTimeout(drift, 9000);
      };
      driftTimer = setTimeout(drift, 1800);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) clearTimeout(driftTimer);
      });
      reducedMotion.addEventListener?.("change", event => {
        if (event.matches) clearTimeout(driftTimer);
      });
    }

  })();
</script>

</body>
</html>
