PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/location_tracker
JWT_SECRET=replace_with_a_long_random_secret
GEMINI_API_KEY=your_google_ai_studio_api_key
# Set this to your deployed app origin when deployed, e.g. https://your-app.example
CLIENT_ORIGIN=http://localhost:3000
# Location-event detection thresholds (optional defaults: 150m and 15 minutes)
VISIT_RADIUS_METERS=150
MIN_STAY_MINUTES=15
# Reverse geocoding is opt-in. Keep disabled unless you have reviewed the provider's usage/privacy terms.
GEOCODING_ENABLED=false
