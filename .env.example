PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/location_tracker
JWT_SECRET=replace_with_a_long_random_secret
# Used by Reva for natural-language generation
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
CLIENT_ORIGIN=http://localhost:3000
# Standalone Reva Mobility Context microservice
MOBILITY_SERVICE_URL=http://127.0.0.1:3101
MOBILITY_CALLBACK_SECRET=use-the-same-long-random-secret-in-main-app-and-mobility-service
VISIT_RADIUS_METERS=150
MIN_STAY_MINUTES=15
# Python LangChain/LangGraph RAG microservice
RAG_SERVICE_URL=http://127.0.0.1:8001
RAG_SERVICE_TOKEN=replace_with_a_long_random_shared_secret
RAG_SERVICE_TIMEOUT_MS=30000
# Python-owned semantic retrieval (all-MiniLM-L6-v2 outputs 384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_VECTOR_INDEX=location_event_vector_index_384
RAG_TOP_K=10

# Optional override for the public OpenStreetMap-based Valhalla router.
VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
