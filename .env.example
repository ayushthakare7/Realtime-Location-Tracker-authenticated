PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/location_tracker
JWT_SECRET=replace_with_a_long_random_secret
# Used for embeddings / semantic retrieval
GEMINI_API_KEY=your_google_ai_studio_api_key
# Used by Reva for natural-language generation
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
CLIENT_ORIGIN=http://localhost:3000
VISIT_RADIUS_METERS=150
MIN_STAY_MINUTES=15
GEOCODING_ENABLED=false
# Semantic RAG configuration
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RAG_VECTOR_INDEX=location_event_vector_index
