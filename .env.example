PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/location_tracker
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:3000

# Reva answer generation (used by the Python RAG service)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Internal Node.js -> Python RAG service connection
RAG_SERVICE_URL=http://127.0.0.1:8001
RAG_SERVICE_TOKEN=replace_with_a_different_long_random_secret
RAG_PORT=8001
RAG_VECTOR_INDEX=location_event_vector_index_384
LOCATION_EVENTS_COLLECTION=locationevents
# Set only if the database name is not present in MONGO_URI
# MONGO_DB_NAME=location_tracker

VISIT_RADIUS_METERS=150
MIN_STAY_MINUTES=15
# Node event creation/indexing uses Xenova/all-MiniLM-L6-v2 (384 dimensions).
# Python retrieval uses the matching sentence-transformers/all-MiniLM-L6-v2 model.
